# CFG Studio — environment configuration template.
# Copy this file to `.env` and adjust the values for your environment.
# DATABASE_URL is required; the others have sensible defaults.

# Port the HTTP server listens on.
PORT=3000

# Runtime environment: development | production.
# In production, unexpected (500) errors are answered with a generic message
# instead of their internal one, static assets are cached, the platform's
# proxy is trusted and the session cookie is sent over HTTPS only.
NODE_ENV=development

# PostgreSQL connection string for development. REQUIRED — the app refuses
# to start without it. Any empty PostgreSQL >= 13 will do, hosted or local;
# the server creates its own tables on startup.
#
# TLS is driven entirely by this string, not by code:
#   hosted -> sslmode=verify-full  (verifies the certificate chain AND hostname)
#   local  -> sslmode=disable      (a local server usually has no certificate)
# Use verify-full rather than require: they behave identically in pg 8, but
# `require` prints a deprecation warning and weakens to unverified TLS in pg 9.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# Connection string used by `npm test`. Must point at a LOCAL PostgreSQL:
# the suite runs hundreds of queries, so network latency and a suspended
# serverless database would make runs slow and erratic. The suite creates a
# dedicated schema inside this database and drops it afterwards, so it never
# touches development data. The database name must end in _test.
TEST_DATABASE_URL=postgresql://cfg_studio:cfg_studio@localhost:5432/cfg_studio_test?sslmode=disable

# First administrator, created on startup if no admin exists yet.
# The password is hashed with scrypt before it is stored; it is never
# persisted in plain text and never appears in the source.
# If these are unset the app still starts and the open API still works, but
# nobody can sign in to the web UI until an administrator exists — see
# README.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
