# CFG Studio — environment configuration template.
# Copy this file to `.env` and adjust the values for your environment.
# Every variable has a sensible default, so the app also runs with no .env at all.

# Port the HTTP server listens on.
PORT=3000

# Runtime environment: development | production.
# In production, error responses hide stack traces and static assets are cached.
NODE_ENV=development

# Directory where user grammars are persisted as JSON files.
# Relative paths are resolved against the project root.
DATA_DIR=./data/grammars
