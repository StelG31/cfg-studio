{
  "name": "cfg-studio",
  "version": "1.0.0",
  "description": "CFG Studio — an educational web application for the design and computation of Context-Free Grammars (grammar editing, validation, CNF conversion, CYK parsing and parse-tree visualisation). Bachelor's thesis project.",
  "type": "module",
  "main": "server.js",
  "author": "Stelios Georgiou",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "core/**/*.js",
      "models/**/*.js",
      "services/**/*.js",
      "controllers/**/*.js",
      "utils/**/*.js"
    ]
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
